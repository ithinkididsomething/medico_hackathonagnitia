# Copy this file to `.env` and adjust values for your machine.
# NEVER put real secrets in `.env.example` — `.env` is git-ignored.

# --- Backend ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Origin allowed to call the API (the React dev server).
FRONTEND_ORIGIN=http://localhost:5173

# Database connection. Default is a local SQLite file (see DATABASE_PATH).
# Any SQLAlchemy-style URL works — e.g. PostgreSQL/Supabase:
#   DATABASE_URL=postgresql://user:password@host:5432/medico
# Credentials in the URL are never returned by API endpoints.
# DATABASE_URL=

# SQLite-only shortcut: file path of the local database.
# Relative paths resolve from the backend working directory.
# DATABASE_PATH=./data/medico.db

# --- Frontend (used by Vite) ---
# Leave empty to use the dev proxy (/api -> BACKEND_URL).
VITE_API_BASE_URL=
# Where the Vite dev server proxies /api to.
BACKEND_URL=http://127.0.0.1:8000

# --- OpenStreetMap / routing (no API key needed for the defaults) ---
# Geocoding: Nominatim (https://nominatim.org) — free, requires a User-Agent.
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
# Routing: OSRM public demo server (https://project-osrm.org).
ROUTER_BASE_URL=https://router.project-osrm.org
ROUTER_PROFILE=driving
# Map tile layer used by the React map component.
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Identify your app when calling Nominatim/OSRM. Include a contact address.
USER_AGENT=medico-dev/0.1 (set-your-contact-here)

# Only needed if you later switch to a provider that requires a key.
ROUTING_API_KEY=
# Set to false to disable live road routing: the app then uses straight-line
# placeholder travel estimates (useful offline / in tests).
ROUTING_ENABLED=true

# --- Demo clinic location (no browser geolocation required) ---
# Change these (or PATCH /api/clinics/current) to move the clinic used as
# the routing origin for travel-aware hospital ranking.
CLINIC_LATITUDE=23.2599
CLINIC_LONGITUDE=77.4126
